<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
        "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml" xml:lang="$messages.locale.language" lang="$messages.locale.language">
<head>
	<script type="text/javascript" src="js/jquery-1.12.0.min.js"></script>
	<script type="text/javascript" src="js/bootstrap.min.js"></script>
	<link rel="stylesheet" href="css/bootstrap.min.css"/>
	<link rel="stylesheet" href="css/reportng.css"/>
</head>
<body>
#set ($suiteAttr = $suiteAttr)
#set ($issues = $issues)
	<div id="overview" class="menuItem" style="display:inline">
		<h3 class="normal">$messages.getString("overview")</h3>
		<div class="container">
			<div class="well well-large">
				<b>$messages.getString("tests")</b>
				<table class="table table-bordered">
					<thead>
						<tr class="test">
							<th scope="col" width="25%;">#</th>
							#if ($utils.hasNewFeatures($suites))
						  		<th scope="col" width="25%;" style="text-align:center">$messages.getString("regression")</th>
						  		<th scope="col" width="25%;" style="text-align:center">$messages.getString("newFeatures")</th>
						  	#end
							<th scope="col" width="25%;" style="text-align:center">$messages.getString("total")</th>
						</tr>
					</thead>
					<tbody>
						<tr class="test">
							<th scope="row" class="passTitle">$messages.getString("pass")</th>
							#if ($utils.hasNewFeatures($suites))
								<td style="font-weight:bold;text-align:center">$suiteAttr.getRegressionPass()</td>
						  		<td style="font-weight:bold;text-align:center">$suiteAttr.getNewFeaturesPass()</td>
						  	#end
						  	<td style="font-weight:bold;text-align:center">$suiteAttr.getTotalPass()</td>
						</tr>
						<tr class="test">
							<th scope="row" class="failTitle">$messages.getString("fail")</th>
							#if ($utils.hasNewFeatures($suites))
								<td style="font-weight:bold;text-align:center">$suiteAttr.getRegressionFail()</td>
								<td style="font-weight:bold;text-align:center">$suiteAttr.getNewFeaturesFail()</td>
							#end
							<td style="font-weight:bold;text-align:center">$suiteAttr.getTotalFail()</td>
						</tr>
						<tr class="test">
							<th scope="row" class="skipTitle">$messages.getString("skip")</th>
							#if ($utils.hasNewFeatures($suites))
								<td style="font-weight:bold;text-align:center">$suiteAttr.getRegressionSkip()</td>
								<td style="font-weight:bold;text-align:center">$suiteAttr.getNewFeaturesSkip()</td>
							#end
							<td style="font-weight:bold;text-align:center">$suiteAttr.getTotalSkip()</td>
						</tr>
						#if ($utils.knownDefectMode())
							<tr class="test">
								<th scope="row" class="KnownDefectTitle">$messages.getString("known")</th>
								#if ($utils.hasNewFeatures($suites))
									<td style="font-weight:bold;text-align:center">$suiteAttr.getRegressionKnownDefect()</td>
									<td style="font-weight:bold;text-align:center">$suiteAttr.getNewFeaturesKnownDefect()</td>
								#end
								<td style="font-weight:bold;text-align:center">$suiteAttr.getTotalKnownDefect()</td>
							</tr>
							<tr class="test">
								<th scope="row" class="fixedTitle">$messages.getString("fixed")</th>
								#if ($utils.hasNewFeatures($suites))
									<td style="font-weight:bold;text-align:center">$suiteAttr.getRegressionFixed()</td>
									<td style="font-weight:bold;text-align:center">$suiteAttr.getNewFeaturesFixed()</td>
								#end
								<td style="font-weight:bold;text-align:center">$suiteAttr.getTotalFixed()</td>
							</tr>
						#end
						<tr class="test">
							<th scope="row" class="summary">$messages.getString("summary")</th>
							#if ($utils.hasNewFeatures($suites))
								<td style="font-weight:bold;text-align:center">$suiteAttr.getSummaryRegression()</td>
								<td style="font-weight:bold;text-align:center">$suiteAttr.getSummaryNewFeature()</td>
							#end
							<td style="font-weight:bold;text-align:center">$suiteAttr.getSummaryTotal()</td>
						</tr>
					</tbody>
				</table>
				<table class="table table-bordered">
					<thead>
						<tr>
							<th scope="col" width="300px;">#</th>
						  	#if ($utils.hasNewFeatures($suites))
						  		<th scope="col" width="300px;" style="text-align:center">$messages.getString("regression")</th>
						  		<th scope="col" width="300px;" style="text-align:center">$messages.getString("newFeatures")</th>
							#end
							<th scope="col" width="300px;" style="text-align:center">$messages.getString("total")</th>
						</tr>
					</thead>
					<tbody>
						<tr class="test">
							<th scope="row" class="summary">$messages.getString("successRate")</th>
							#if ($utils.hasNewFeatures($suites))
								<td style="font-weight:bold;text-align:center">$utils.getProgress($suiteAttr.getRegression())</td>
								<td style="font-weight:bold;text-align:center">$utils.getProgress($suiteAttr.getNewFeatures())</td>
							#end
							<td style="font-weight:bold;text-align:center">$utils.getProgress($suiteAttr.getTotal())</td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>
		<div class="container">
			<div class="well well-large">
				<b>$messages.getString("issues")</b>
				<table class="table table-bordered">
				<thead>
				<tr class="test">
					<th scope="col" width="25%;">#</th>
					#if ($utils.hasNewFeatures($suites))
						<th scope="col" width="25%;" style="text-align:center">$messages.getString("regression")</th>
						<th scope="col" width="25%;" style="text-align:center">$messages.getString("newFeatures")</th>
				  	#end
				  	<th scope="col" width="25%;" style="text-align:center">$messages.getString("total")</th>
					</tr>
				</thead>
				<tbody>
					<tr class="test">
						<th scope="row" class="failTitle">$messages.getString("newIssues")</th>
						#if ($utils.hasNewFeatures($suites))
							<td style="font-weight:bold;text-align:center" title="$messages.getString("clickNewIssuesRegressionTests")"><a href="newIssues.html">$issues.getNewIssuesRegression().size()</a></td>
							<td style="font-weight:bold;text-align:center" title="$messages.getString("clickNewIssuesFeatureTests")"><a href="newIssues.html">$issues.getNewIssuesNewFeature().size()</a></td>
						#end
						<td style="font-weight:bold;text-align:center" title="$messages.getString("clickNewIssues")"><a href="newIssues.html">$issues.getNewIssuesAmount()</a></td>
					</tr>
					#if ($utils.knownDefectMode())
						<tr class="test">
							<th scope="row" class="KnownDefectTitle">$messages.getString("knownIssues")</th>
							#if ($utils.hasNewFeatures($suites))
								<td style="font-weight:bold;text-align:center" title="$messages.getString("clickKnownIssuesRegressionTests")"><a href="knownIssues.html">$issues.getKnownIssuesRegression().size()</a></td>
								<td style="font-weight:bold;text-align:center" title="$messages.getString("clickKnownIssuesFeatureTests")"><a href="knownIssues.html">$issues.getKnownIssuesNewFeature().size()</a></td>
							#end
							<td style="font-weight:bold;text-align:center" title="$messages.getString("clickKnownIssues")"><a href="knownIssues.html">$issues.getKnownIssuesAmount()</a></td>
						</tr>
						<tr class="test">
							<th scope="row" class="fixedTitle">$messages.getString("fixedIssues")</th>
							#if ($utils.hasNewFeatures($suites))
								<td style="font-weight:bold;text-align:center" title="$messages.getString("clickFixedIssuesRegressionTests")"><a href="fixedIssues.html">$issues.getFixedIssuesRegression().size()</a></td>
								<td style="font-weight:bold;text-align:center" title="$messages.getString("clickFixedIssuesFeatureTests")"><a href="fixedIssues.html">$issues.getFixedIssuesNewFeature().size()</a></td>
							#end
							<td style="font-weight:bold;text-align:center" title="$messages.getString("clickFixedIssues")"><a href="fixedIssues.html">$issues.getFixedIssuesAmount()</a></td>
						</tr>
						<tr class="test">
							<th scope="row" class="skipTitle">$messages.getString("skippedIssues")</th>
							#if ($utils.hasNewFeatures($suites))
								<td style="font-weight:bold;text-align:center" title="$messages.getString("clickSkippedIssuesRegressionTests")"><a href="skippedIssues.html">$issues.getSkippedIssuesRegression().size()</a></td>
								<td style="font-weight:bold;text-align:center" title="$messages.getString("clickSkippedIssuesFeatureTests")"><a href="skippedIssues.html">$issues.getSkippedIssuesNewFeature().size()</a></td>
							#end
							<td style="font-weight:bold;text-align:center" title="$messages.getString("clickSkippedIssues")"><a href="skippedIssues.html">$issues.getSkippedIssuesAmount()</a></td>
						</tr>
					#end
				</tbody>
				</table>
			</div>
		</div>
		<div class="container">
			<div class="well well-large">
				<b>$messages.getString("releaseStatus")</b>
				<p>$utils.getReleaseStatus($suites)</p>
			</div>
		</div>
		<div class="container">
			<div class="well well-large">
				<b>$messages.getString("reportTitleHeader")</b>
				<p>$meta.reportTitle</p>
			</div>
		</div>
		<div class="container">
			<div class="well well-large">
				<b>$messages.getString("reportExecutionHeader")</b>
				<table class="table">
				  <tr>
				    <th>$messages.getString("startTime") : </th>
				    <th>$suiteAttr.getStartDate()</th> 
				  </tr>
				  <tr>
				    <th>$messages.getString("endTime") : </th>
				    <th>$suiteAttr.getEndDate()</th> 
				  </tr>
				  <tr>
				    <th>$messages.getString("totalTime") : </th>
				    <th>$suiteAttr.getExecutionTime()</th> 
				  </tr>
				  <tr>
				    <th>$messages.getString("reportOutput") : </th>
				    <th>$utils.getReportOutput()</th> 
				  </tr>
				  <tr>
				    <th>$messages.getString("host") : </th>
				    <th>$meta.user&nbsp;/&nbsp;$meta.javaInfo&nbsp;/&nbsp;$meta.platform</th> 
				  </tr>
				</table>
			</div>
		</div>
		<div class="container">
			<div class="well well-large">
				<b>$messages.getString("reportInfoHeader")</b>
				<p>$messages.getString("generatedBy") $messages.getString("atTime") $meta.reportTime $messages.getString("onDate") $meta.reportDate<br/></p>
			</div>	
		</div>
	</div>
</body>
</html>