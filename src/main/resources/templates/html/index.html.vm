<!DOCTYPE html>
<html lang="$messages.locale.language">
<head>
  <title>$messages.getString("htmlTitle")</title>
  <meta charset="utf-8" />
  <meta name="description" content="TestNG unit test results." />
  <link rel="icon" type="image/png" href="images/fav.png">
  <style>
    html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }
    #layout { display: flex; height: 100vh; }
    #menu-frame { width: 250px; flex-shrink: 0; border: none; height: 100%; }
    #content-frame { flex: 1; border: none; height: 100%; }
  </style>
</head>
<body>
  <div id="layout">
    <iframe id="menu-frame" src="menu.html" title="Navigation menu"></iframe>
    <iframe id="content-frame" name="overview" src="overview.html" title="Test results"></iframe>
  </div>
</body>
</html>
